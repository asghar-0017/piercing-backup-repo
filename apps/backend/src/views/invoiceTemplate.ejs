      Telephone. <%= invoice.telNo || '(021) 349-22-329 / (021) 349-22-327 /(021) 349-22-328' %> Mobile & What's App.
        <%= invoice.mobNo || '+923331025202' %><br>
          Email. <%= invoice.email || 'sales@piercingsystems.pk / info@piercingsystems.pk' %><br>
            Customer Signature
    </div>

    <div class="footer-meta">
      <hr style="border: 0; border-top: 1px solid #000; margin-bottom: 4px;">
      <table style="margin: 0; font-size: 9px;">
        <tr>
          <td><strong>User name :</strong>
            <%= invoice.created_by_name || 'System' %>
          </td>
          <td class="text-center"><strong>Print Date & Time :</strong>
            <%= new Date().toLocaleString('en-GB', { day: '2-digit' , month: '2-digit' , year: 'numeric' ,
              hour: '2-digit' , minute: '2-digit' , second: '2-digit' , hour12: false }).replace(',', '' ) %>
          </td>
          <td class="text-right"><strong>Page :</strong> <%= totalPages %> / <%= totalPages %></td>
        </tr>
      </table>
    </div>
  </div>

</body>

