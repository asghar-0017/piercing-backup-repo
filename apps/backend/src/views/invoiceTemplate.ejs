                and that all particulars are true and correct.<br>
                THIS INVOICE IS SUBJECT TO TERMS & CONDITIONS PRINTED OVERLEAF & I HEREBY ACCEPT THIS INVOICE.
              </div>
              <div class="bold" style="margin-top: 4px; font-size: 9.5px;">Goods Received By :</div>
              <div class="bold" style="margin-top: 2px; font-size: 9.5px;">Date : <span style="font-weight: normal;">
                  <%= invoice.invoiceDate || '' %>
                </span></div>
            </td>

            <td style="width: 37%; padding: 4px 6px 3px 4px; vertical-align: top;">
              <table style="width: 100%; border-collapse: collapse; font-size: 9.5px;">
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px; width: 60%;">Gross Total :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0; width: 40%;">
                    <%= Number(sumGrossTotal).toLocaleString(undefined, {minimumFractionDigits: 2,
                      maximumFractionDigits: 2}) %>
                  </td>
                </tr>
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px;">Discount :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0;">
                    <%= Number(sumDiscount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits:
                      2}) %>
                  </td>
                </tr>
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px;">Courier Charges :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0;">
                    <%= Number(sumCourier).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits:
                      2}) %>
                  </td>
                </tr>
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px;">Sales Tax (GST) :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0;">
                    <%= Number(sumTaxable).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits:
                      2}) %>
                  </td>
                </tr>
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px;">Further Tax 4% :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0;">
                    <%= Number(sumFurther).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits:
                      2}) %>
                  </td>
                </tr>
                <tr>
                  <td class="bold" style="text-align: right; padding: 1.5px 2px;">Total :</td>
                  <td class="bold" style="text-align: right; padding: 1.5px 0;">
                    <%= Number(finalTotal).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits:
                      2}) %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding: 3px 6px; vertical-align: middle; border-top: 1px solid #000;">
              <div class="bold" style="font-size: 9.5px;">
                Amount In Words : <span style="font-weight: normal; font-size: 9.5px;">PKR &nbsp;<%= typeof convertToWords
                    !=='undefined' ? convertToWords(finalTotal) : '' %></span>
              </div>
            </td>
          </tr>
        </table>

        <!-- Bank Details & Signatory -->
        <table class="avoid-break" style="width: 100%; border-collapse: collapse; border: 1px solid #000; margin-top: 5px;">
          <tr>
            <td style="width: 58%; padding: 4px 6px 4px 6px; vertical-align: top;">
              <div class="bold" style="text-decoration: underline; margin-bottom: 3px; font-size: 10px;">BANK DETAILS :
              </div>
              <table style="width: 100%; border-collapse: collapse; font-size: 9.5px; line-height: 1.3;">
                <tr>
                  <td style="padding: 1px 0; width: 95px; font-weight: normal;">Account Title</td>
                  <td style="padding: 1px 0; width: 10px; text-align: center;">:</td>
                  <td style="padding: 1px 0; font-weight: normal;">
                    Piercing Systems Pakistan (Pvt) Ltd
                  </td>
                </tr>
                <tr>
                  <td style="padding: 1px 0; font-weight: normal;">Bank</td>
                  <td style="text-align: center;">:</td>
                  <td style="padding: 1px 0; font-weight: normal;">Bank Al Habib Limited</td>
                </tr>
                <tr>
                  <td style="padding: 1px 0; font-weight: normal;">IBAN</td>
                  <td style="text-align: center;">:</td>
                  <td style="padding: 1px 0; font-weight: normal;">PK70 BAHL 1007 0981 0205 5301</td>
                </tr>
                <tr>
                  <td style="padding: 1px 0; font-weight: normal;">Branch</td>
                  <td style="text-align: center;">:</td>
                  <td style="padding: 1px 0; font-weight: normal;">Bahadurabad, Karachi</td>
                </tr>
                <tr>
                  <td style="padding: 1px 0; font-weight: normal;">NTN</td>
                  <td style="text-align: center;">:</td>
                  <td style="padding: 1px 0; font-weight: normal;">3609587-7</td>
                </tr>
              </table>
            </td>

            <td style="width: 42%; padding: 4px 6px 3px 4px; vertical-align: top; text-align: right; position: relative;">
              <div class="bold" style="font-size: 10px; margin-bottom: 2px; text-align: right; color: #000;">
                Piercing Systems Pakistan Pvt Ltd
              </div>
              <div style="text-align: right; padding-right: 25px; margin-top: 1px;">
                <img src="data:image/png;base64,<%= stampLogoBase64 %>" alt="Authorized Signatory Stamp"
                  style="max-width: 65px; height: auto; display: inline-block;">
              </div>
              <div class="bold" style="font-size: 9px; text-align: right; padding-right: 10px; margin-top: 2px;">
                AUTHORISED SIGNATORY
              </div>
            </td>
          </tr>
        </table>

        <div class="text-center bold" style="margin-top: 4px; font-size: 9.5px; font-family: Arial, sans-serif;">
          "This is Computer Generated Invoice"
        </div>

        <% if ((typeof showFbrLogo !=='undefined' && showFbrLogo) || (typeof showQRCode !=='undefined' && showQRCode)) { %>
          <table style="width: 100%; margin-top: 3px; border-collapse: collapse;">
            <tr>
              <td style="width: 50%; text-align: left; vertical-align: middle;">
                <% if (typeof showFbrLogo !=='undefined' && showFbrLogo && typeof companyLogoBase64 !=='undefined' ) { %>
                  <img src="data:image/png;base64,<%= companyLogoBase64 %>" alt="FBR Logo"
                    style="max-width: 60px; height: auto;">
                  <% } %>
              </td>
              <td style="width: 50%; text-align: right; vertical-align: middle;">
                <% if (typeof showQRCode !=='undefined' && showQRCode && typeof qrData !=='undefined' ) { %>
                  <img src="<%= qrData %>" alt="QR Code" style="max-width: 60px; height: auto;">
                <% } %>
              </td>
            </tr>
          </table>
        <% } %>
      <% } %>

      <div class="footer-meta">
        <hr style="border: 0; border-top: 1px solid #000; margin-bottom: 4px;">
        <table style="margin: 0; font-size: 9px;">
          <tr>
            <td><strong>User name :</strong>
              <%= invoice.created_by_name || 'System' %>
            </td>
            <td class="text-center"><strong>Print Date & Time :</strong>
              <%= new Date().toLocaleString('en-GB', { day: '2-digit' , month: '2-digit' , year: 'numeric' ,
                hour: '2-digit' , minute: '2-digit' , second: '2-digit' , hour12: false }).replace(',', '' ) %>
            </td>
            <td class="text-right"><strong>Page :</strong> <%= currentPageNum %> / <%= totalPages %></td>
          </tr>
        </table>
      </div>
    </div>
  <% }); %>

  <!-- Terms & Conditions Page -->
